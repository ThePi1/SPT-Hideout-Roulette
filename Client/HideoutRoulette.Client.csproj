    <Version>0.1.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Game install to compile against, override with: dotnet build -p:SptDir=... -->
    <SptDir Condition="'$(SptDir)' == ''">I:\Games\spt-4-0-13-hideoutroulette</SptDir>
